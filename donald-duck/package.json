{
  "name": "@local/donald-duck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.js",
    "pretest": "node scripts/build.js",
    "prepack": "node scripts/build.js",
    "test": "node test/smoke.js && node test/drag.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/donald-duck-icon.png"
  },
  "files": ["index.js", "client.js", "client.source.js", "scripts/build.js", "test/*.js", "assets/donald-duck.png", "assets/donald-duck-icon.png", "cordis.patch.yml", "locale/*.json"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
